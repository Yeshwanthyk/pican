{
  "name": "pican-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "knip": "knip",
    "lint": "oxlint",
    "format": "oxfmt && prettier --write \"src/**/*.svelte\"",
    "format:check": "oxfmt --check . && prettier --check \"src/**/*.svelte\"",
    "typecheck": "tsc --noEmit && svelte-check --threshold error",
    "build": "vite build && npm run build:export",
    "build:export": "vite build --config vite.config.export.js && cp dist-export/export.js ../internal/ui/embedded/export/export.js",
    "dev": "npm run build:export && vite build --watch"
  },
  "dependencies": {
    "@pierre/diffs": "^1.2.10",
    "effect": "4.0.0-beta.98",
    "highlight.js": "latest",
    "lucide": "^1.17.0",
    "marked": "latest"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "jsdom": "latest",
    "knip": "^6.16.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "prettier": "3.8.3",
    "prettier-plugin-svelte": "4.1.0",
    "svelte": "^5.56.2",
    "svelte-check": "^4.7.3",
    "typescript": "^5.9.3",
    "vite": "latest",
    "vitest": "latest"
  }
}
